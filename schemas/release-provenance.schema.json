{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-engine.app/schemas/release-provenance.schema.json",
  "title": "Context Engine release provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "version",
    "tag",
    "source_commit",
    "distribution_commit",
    "distribution_tag_target",
    "release_descriptor",
    "manifest",
    "assembly_facts",
    "authorized_stages",
    "decisions",
    "license_identity",
    "workflows",
    "runner_selections",
    "builds",
    "payload_verifications",
    "artifacts",
    "grammar_inventory",
    "packaging",
    "candidates"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "profile": { "type": "string", "enum": ["desktop", "desktop-linux", "repository-bootstrap"] },
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "tag": { "type": "string", "pattern": "^(?:v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)|repository-bootstrap-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))$" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "distribution_commit": { "$ref": "#/$defs/commit" },
    "distribution_tag_target": { "$ref": "#/$defs/commit" },
    "release_descriptor": { "$ref": "#/$defs/descriptorRef" },
    "manifest": { "$ref": "#/$defs/fileRef" },
    "assembly_facts": { "$ref": "#/$defs/fileRef" },
    "authorized_stages": {
      "oneOf": [
        { "const": ["source-release", "public-draft"] },
        { "const": ["source-release", "public-draft", "package-channels"] },
        { "const": ["source-release", "public-draft", "public-publish", "package-channels"] }
      ]
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "package_binding", "bootstrap"],
      "properties": {
        "targets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/target" } },
        "package_binding": { "$ref": "#/$defs/bindingSummary" },
        "bootstrap": { "$ref": "#/$defs/bindingSummary" }
      }
    },
    "license_identity": { "$ref": "#/$defs/licenseIdentity" },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source-release": { "$ref": "#/$defs/workflowRef" },
        "public-draft": { "$ref": "#/$defs/workflowRef" },
        "public-publish": { "$ref": "#/$defs/workflowRef" },
        "package-channels": { "$ref": "#/$defs/workflowRef" }
      },
      "oneOf": [
        {
          "required": ["source-release", "public-draft"],
          "minProperties": 2,
          "maxProperties": 2
        },
        {
          "required": ["source-release", "public-draft", "package-channels"],
          "minProperties": 3,
          "maxProperties": 3
        },
        {
          "required": ["source-release", "public-draft", "public-publish", "package-channels"],
          "minProperties": 4,
          "maxProperties": 4
        }
      ]
    },
    "runner_selections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "verify", "packaging"],
      "properties": {
        "build": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/runnerSelection" } },
        "verify": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/runnerSelection" } },
        "packaging": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/runnerSelection" } }
      }
    },
    "builds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payload_id", "script", "script_sha256", "build_record_sha256", "build_record"],
        "properties": {
          "payload_id": { "type": "string", "pattern": "^context-engine-[A-Za-z0-9._-]+$" },
          "script": { "type": "string", "enum": ["scripts/build_mac.sh", "scripts/build_win.sh", "scripts/build_linux.sh"] },
          "script_sha256": { "$ref": "#/$defs/sha256" },
          "build_record_sha256": { "$ref": "#/$defs/sha256" },
          "build_record": { "$ref": "#/$defs/buildRecord" }
        }
      }
    },
    "payload_verifications": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payload_id", "payload_verification_sha256", "payload_verification"],
        "properties": {
          "payload_id": { "type": "string", "pattern": "^context-engine-[A-Za-z0-9._-]+$" },
          "payload_verification_sha256": { "$ref": "#/$defs/sha256" },
          "payload_verification": { "$ref": "#/$defs/payloadVerification" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "filename", "sha256", "size"],
          "properties": {
          "kind": { "type": "string", "enum": ["archive", "native-package", "sbom", "common", "bootstrap-package"] },
          "package_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
          "package_format": { "type": "string", "enum": ["deb", "rpm"] },
          "repository_source_format": { "type": "string", "enum": ["list", "sources", "repo"] },
          "package_suite": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "package_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "package_manifest_sha256": { "$ref": "#/$defs/sha256" },
          "package_verification_sha256": { "$ref": "#/$defs/sha256" },
          "filename": { "type": "string", "pattern": "^[^/\\\\]+$" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "enum": ["archive", "sbom", "common"] } } },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["package_id"] },
                  { "required": ["package_format"] },
                  { "required": ["repository_source_format"] },
                  { "required": ["package_suite"] },
                  { "required": ["package_version"] },
                  { "required": ["package_manifest_sha256"] },
                  { "required": ["package_verification_sha256"] }
                ]
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "native-package" } } },
            "then": {
              "required": ["package_id", "package_format", "package_suite", "package_version", "package_manifest_sha256", "package_verification_sha256"],
              "not": { "required": ["repository_source_format"] }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "bootstrap-package" } } },
            "then": {
              "required": ["package_id", "package_format", "package_suite", "package_version", "package_manifest_sha256", "package_verification_sha256"],
              "properties": {
                "package_id": {
                  "anyOf": [
                    { "const": "context-engine-archive-keyring" },
                    { "pattern": "^context-engine-repository-config-" },
                    { "const": "context-engine-release" }
                  ]
                }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "bootstrap-package" }, "package_id": { "const": "context-engine-archive-keyring" } } },
            "then": {
              "properties": { "package_format": { "const": "deb" } },
              "not": { "required": ["repository_source_format"] }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "bootstrap-package" }, "package_id": { "pattern": "^context-engine-repository-config-" } } },
            "then": {
              "required": ["repository_source_format"],
              "properties": {
                "package_format": { "const": "deb" },
                "repository_source_format": { "enum": ["list", "sources"] }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "bootstrap-package" }, "package_id": { "const": "context-engine-release" } } },
            "then": {
              "required": ["repository_source_format"],
              "properties": {
                "package_format": { "const": "rpm" },
                "repository_source_format": { "const": "repo" }
              }
            }
          }
        ]
      }
    },
    "grammar_inventory": {
      "oneOf": [
        { "$ref": "#/$defs/fileRef" },
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "not-applicable" } } }
      ]
    },
    "packaging": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["container_image", "archiver", "tool_digests", "reproducibility", "signing"],
          "properties": {
        "container_image": { "type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$" },
        "archiver": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+@[A-Za-z0-9._+-]+$" },
        "tool_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "sha256"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" },
              "version": { "$ref": "#/$defs/toolVersion" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "reproducibility": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/reproducibilityRecord" } },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "tool_sha256", "verified"],
          "properties": {
            "tool": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" },
            "tool_sha256": { "$ref": "#/$defs/sha256" },
            "verified": { "const": true }
          }
        }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "not-applicable" } } }
      ]
    },
    "candidates": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["document", "archive", "outputs", "generator"],
          "properties": {
            "document": { "$ref": "#/$defs/candidateFileRef" },
            "archive": { "$ref": "#/$defs/candidateFileRef" },
            "outputs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/legacyCandidateOutput" }
            },
            "generator": { "$ref": "#/$defs/generatorProvenance" }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "not-applicable" } } }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "desktop-linux" }, "version": { "const": "0.1.0" } }, "required": ["profile", "version"] },
      "then": {
        "oneOf": [
          {
            "properties": {
              "authorized_stages": { "const": ["source-release", "public-draft"] },
              "workflows": { "required": ["source-release", "public-draft"], "minProperties": 2, "maxProperties": 2 }
            }
          },
          {
            "properties": {
              "authorized_stages": { "const": ["source-release", "public-draft", "public-publish", "package-channels"] },
              "workflows": { "required": ["source-release", "public-draft", "public-publish", "package-channels"], "minProperties": 4, "maxProperties": 4 }
            }
          }
        ]
      },
      "else": {
        "oneOf": [
          {
            "properties": {
              "authorized_stages": { "const": ["source-release", "public-draft"] },
              "workflows": { "required": ["source-release", "public-draft"], "minProperties": 2, "maxProperties": 2 }
            }
          },
          {
            "properties": {
              "authorized_stages": { "const": ["source-release", "public-draft", "package-channels"] },
              "workflows": { "required": ["source-release", "public-draft", "package-channels"], "minProperties": 3, "maxProperties": 3 }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "profile": { "const": "repository-bootstrap" } } },
      "then": {
        "properties": {
          "license_identity": { "const": { "mode": "not-applicable" } },
          "builds": { "const": [] },
          "payload_verifications": { "const": [] },
          "grammar_inventory": { "const": { "status": "not-applicable" } },
          "packaging": { "$ref": "#/$defs/packagingFacts" },
          "candidates": { "const": { "status": "not-applicable" } }
        }
      }
    },
    {
      "if": { "properties": { "profile": { "enum": ["desktop", "desktop-linux"] } } },
      "then": {
        "properties": {
          "license_identity": { "required": ["key_id", "public_key_sha256"] },
          "builds": { "minItems": 1 },
          "payload_verifications": { "minItems": 1 },
          "grammar_inventory": { "$ref": "#/$defs/fileRef" },
          "packaging": { "$ref": "#/$defs/packagingFacts" },
          "candidates": { "$ref": "#/properties/candidates" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": { "const": "desktop-linux" },
          "version": { "const": "0.1.0" }
        },
        "required": ["profile", "version"]
      },
      "then": {
        "properties": {
          "candidates": {
            "properties": {
              "outputs": { "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/legacyCandidateOutput" } },
              "generator": {
                "properties": {
                  "templates": { "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/legacyTemplateRef" } },
                  "sources": { "minItems": 12, "maxItems": 12 }
                }
              }
            }
          }
        }
      },
      "else": {
        "if": { "properties": { "profile": { "enum": ["desktop", "desktop-linux"] } }, "required": ["profile"] },
        "then": {
          "properties": {
            "candidates": {
              "properties": {
                "outputs": { "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/currentCandidateOutput" } },
                "generator": {
                  "properties": {
                    "templates": { "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/currentTemplateRef" } },
                    "sources": { "minItems": 5, "maxItems": 5 }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "toolVersion": {
      "type": "string",
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+(?: +[^\\s\\u0000-\\u001F\\u007F-\\u009F]+)*(?![\\s\\S])"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "target": {
      "type": "string",
      "enum": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    },
    "licenseIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key_id", "public_key_sha256"],
          "properties": {
            "key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
            "public_key_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "not-applicable" } }
        }
      ]
    },
    "descriptorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "package_binding_sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^packaging/releases/(?:v[0-9]+\\.[0-9]+\\.[0-9]+|repository-bootstrap-v[0-9]+\\.[0-9]+\\.[0-9]+)\\.json$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "package_binding_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\x00]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "workflowRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "path", "commit", "sha256"],
      "properties": {
        "stage": { "enum": ["source-release", "public-draft", "public-publish", "package-channels"] },
        "path": { "type": "string", "pattern": "^(?:\\.github/workflows|\\.github/actions)/[A-Za-z0-9._/-]+\\.ya?ml$" },
        "commit": { "$ref": "#/$defs/commit" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bindingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sha256"],
      "properties": {
        "mode": { "enum": ["none", "embedded", "referenced", "bootstrap"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runnerSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "target", "architecture", "image"],
      "properties": {
        "role": { "enum": ["build", "verify", "packaging"] },
        "target": { "anyOf": [{ "$ref": "#/$defs/target" }, { "const": "release" }, { "const": "repository" }] },
        "architecture": { "enum": ["x86_64", "arm64", "all"] },
        "image": {
          "description": "Exact hosted-runner label and runtime image version, or an immutable container image digest when the runner is container-backed.",
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        }
      }
    },
    "reproducibilityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "filename", "pass1_sha256", "pass2_sha256", "identical", "final_sha256", "signed", "verified"],
      "properties": {
        "kind": { "enum": ["native-package", "bootstrap-package", "candidate-archive"] },
        "filename": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "pass1_sha256": { "$ref": "#/$defs/sha256" },
        "pass2_sha256": { "$ref": "#/$defs/sha256" },
        "identical": { "const": true },
        "final_sha256": { "$ref": "#/$defs/sha256" },
        "signed": { "type": "boolean" },
        "verified": { "const": true }
      }
    },
    "packagingFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container_image", "archiver", "tool_digests", "reproducibility", "signing"],
      "properties": {
        "container_image": { "type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$" },
        "archiver": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+@[A-Za-z0-9._+-]+$" },
        "tool_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "sha256"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" },
              "version": { "$ref": "#/$defs/toolVersion" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "reproducibility": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/reproducibilityRecord" } },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "tool_sha256", "verified"],
          "properties": {
            "tool": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" },
            "tool_sha256": { "$ref": "#/$defs/sha256" },
            "verified": { "const": true }
          }
        }
      }
    },
    "candidateFileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "enum": ["channel-candidates.json", "channel-candidates.tar.gz"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "currentCandidateOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file_kind", "path", "sha256", "size", "mode"],
      "properties": {
        "kind": { "enum": ["homebrew", "scoop"] },
        "file_kind": { "enum": ["formula", "manifest"] },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9._/-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "mode": { "const": "0644" }
      }
    },
    "legacyCandidateOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file_kind", "path", "sha256", "size", "mode"],
      "properties": {
        "kind": { "enum": ["homebrew", "scoop", "winget"] },
        "file_kind": { "enum": ["formula", "manifest", "version", "installer", "locale"] },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9._/-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "mode": { "const": "0644" }
      }
    },
    "currentTemplateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "enum": [
            "packaging/homebrew/context-engine.rb.in",
            "packaging/scoop/context-engine.json.in"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "legacyTemplateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "enum": [
            "packaging/homebrew/context-engine.rb.in",
            "packaging/scoop/context-engine.json.in",
            "packaging/winget/package.yaml.in",
            "packaging/winget/installer.yaml.in",
            "packaging/winget/locale.en-US.yaml.in"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\x00]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generatorProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_source_commit", "generator_commit", "source_manifest_sha256", "schema_path", "schema_sha256", "templates", "generator_path", "generator_sha256", "sources"],
      "properties": {
        "release_source_commit": { "$ref": "#/$defs/commit" },
        "generator_commit": { "$ref": "#/$defs/commit" },
        "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "schema_path": { "const": "packaging/channel-candidates.schema.json" },
        "schema_sha256": { "$ref": "#/$defs/sha256" },
        "templates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/legacyTemplateRef" } },
        "generator_path": { "const": "scripts/release/render_package_metadata.py" },
        "generator_sha256": { "$ref": "#/$defs/sha256" },
        "sources": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "buildRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "payload_id", "source_commit", "target", "platform", "architecture", "build_mode", "toolchain", "tool", "target_directory", "license_identity", "bypass_environment_absent", "script", "output"],
      "properties": {
        "schema_version": { "const": 1 },
        "payload_id": { "type": "string", "pattern": "^context-engine-[A-Za-z0-9._-]+$" },
        "source_commit": { "$ref": "#/$defs/commit" },
        "target": { "$ref": "#/$defs/target" },
        "platform": { "type": "string", "enum": ["macos", "windows", "linux"] },
        "architecture": { "type": "string", "enum": ["x86_64", "arm64"] },
        "build_mode": { "const": "license-enforced" },
        "toolchain": { "type": "object", "additionalProperties": false, "required": ["channel", "target"], "properties": { "channel": { "type": "string", "minLength": 1 }, "target": { "$ref": "#/$defs/target" } } },
        "tool": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "enum": ["cargo", "cargo-xwin", "cargo-zigbuild"] }, "version": { "type": "string", "minLength": 1 } } },
        "target_directory": { "const": "target/release-enforced" },
        "license_identity": { "$ref": "#/$defs/licenseIdentity" },
        "bypass_environment_absent": { "const": true },
        "script": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "enum": ["scripts/build_mac.sh", "scripts/build_win.sh", "scripts/build_linux.sh"] }, "sha256": { "$ref": "#/$defs/sha256" } } },
        "output": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size", "mode"], "properties": { "path": { "type": "string", "enum": ["dist/mac/context-engine", "dist/win/context-engine.exe", "dist/linux/context-engine", "dist/linux-arm64/context-engine"] }, "sha256": { "$ref": "#/$defs/sha256" }, "size": { "type": "integer", "minimum": 1 }, "mode": { "type": "string", "pattern": "^0[0-7]{3}$" } } }
      }
    },
    "payloadVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "payload_id", "target", "payload_sha256", "payload_size", "version_output", "missing_key_exit", "bypass_marker_absent", "platform_execution"],
      "properties": {
        "schema_version": { "const": 1 },
        "payload_id": { "type": "string", "pattern": "^context-engine-[A-Za-z0-9._-]+$" },
        "target": { "$ref": "#/$defs/target" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "payload_size": { "type": "integer", "minimum": 1 },
        "version_output": { "type": "string", "minLength": 1 },
        "missing_key_exit": { "type": "object", "additionalProperties": false, "required": ["expected", "observed"], "properties": { "expected": { "const": 70 }, "observed": { "const": 70 } } },
        "bypass_marker_absent": { "const": true },
        "platform_execution": { "type": "object", "additionalProperties": false, "required": ["platform", "passed", "checks"], "properties": { "platform": { "type": "string", "enum": ["macos", "windows", "linux"] }, "passed": { "const": true }, "checks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } } }
      }
    }
  }
}
