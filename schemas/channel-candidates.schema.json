{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-engine.app/schemas/channel-candidates.schema.json",
  "title": "Context Engine deterministic channel candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_tag",
    "version",
    "profile",
    "source_manifest_sha256",
    "archive",
    "generator",
    "inputs",
    "candidates"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "release_tag": { "$ref": "#/$defs/releaseTag" },
    "version": { "$ref": "#/$defs/version" },
    "profile": { "type": "string", "enum": ["desktop", "desktop-linux"] },
    "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "archive": { "$ref": "#/$defs/archiveRef" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_source_commit", "generator_commit", "schema_path", "schema_sha256", "templates", "generator_path", "generator_sha256", "sources"],
      "properties": {
        "release_source_commit": { "$ref": "#/$defs/commit" },
        "generator_commit": { "$ref": "#/$defs/commit" },
        "schema_path": { "const": "packaging/channel-candidates.schema.json" },
        "schema_sha256": { "$ref": "#/$defs/sha256" },
        "templates": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/templateRef" } },
        "generator_path": { "const": "scripts/release/render_package_metadata.py" },
        "generator_sha256": { "$ref": "#/$defs/sha256" },
        "sources": { "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloads", "archives"],
      "properties": {
        "payloads": {
          "type": "array",
          "items": { "$ref": "#/$defs/input" },
          "uniqueItems": true
        },
        "archives": {
          "type": "array",
          "items": { "$ref": "#/$defs/input" },
          "uniqueItems": true
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/candidate" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "releaseTag": { "type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "safePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9._/-]+$" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "filename", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^context-engine-[A-Za-z0-9._-]+$" },
        "filename": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "archiveRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "channel-candidates.tar.gz" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "templateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "enum": [
            "packaging/homebrew/context-engine.rb.in",
            "packaging/scoop/context-engine.json.in",
            "packaging/winget/package.yaml.in",
            "packaging/winget/installer.yaml.in",
            "packaging/winget/locale.en-US.yaml.in"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "commonCandidate": {
      "type": "object",
      "required": ["kind", "path", "sha256", "size", "mode"],
      "properties": {
        "kind": { "type": "string" },
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "mode": { "const": "0644" }
      }
    },
    "homebrewCandidate": {
      "allOf": [
        { "$ref": "#/$defs/commonCandidate" },
        {
          "type": "object",
          "required": ["kind", "file_kind", "path"],
          "properties": {
            "kind": { "const": "homebrew" },
            "file_kind": { "const": "formula" },
            "path": { "const": "Formula/context-engine.rb" }
          }
        }
      ]
    },
    "scoopCandidate": {
      "allOf": [
        { "$ref": "#/$defs/commonCandidate" },
        {
          "type": "object",
          "required": ["kind", "file_kind", "path"],
          "properties": {
            "kind": { "const": "scoop" },
            "file_kind": { "const": "manifest" },
            "path": { "const": "bucket/context-engine.json" }
          }
        }
      ]
    },
    "wingetCandidate": {
      "allOf": [
        { "$ref": "#/$defs/commonCandidate" },
        {
          "type": "object",
          "required": ["kind", "file_kind", "path"],
          "properties": {
            "kind": { "const": "winget" },
            "file_kind": { "enum": ["version", "installer", "locale"] },
            "path": {
              "type": "string",
              "pattern": "^manifests/c/ContextEngine/ContextEngine/[0-9]+\\.[0-9]+\\.[0-9]+/ContextEngine\\.ContextEngine(?:\\.installer|\\.locale\\.en-US)?\\.yaml$"
            }
          }
        }
      ]
    },
    "candidate": {
      "oneOf": [
        { "$ref": "#/$defs/homebrewCandidate" },
        { "$ref": "#/$defs/scoopCandidate" },
        { "$ref": "#/$defs/wingetCandidate" }
      ],
      "unevaluatedProperties": false
    }
  }
}
