{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-engine.app/schemas/channel-repair.schema.json",
  "title": "Context Engine metadata-only channel repair",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_tag",
    "version",
    "destination",
    "baseline",
    "replacement",
    "generator",
    "locked_fields",
    "reason"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "release_tag": { "$ref": "#/$defs/releaseTag" },
    "version": { "$ref": "#/$defs/version" },
    "destination": { "$ref": "#/$defs/destination" },
    "baseline": { "$ref": "#/$defs/candidateRef" },
    "replacement": { "$ref": "#/$defs/candidateRef" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_source_commit",
        "generator_commit",
        "schema_sha256",
        "template_sha256",
        "generator_sha256",
        "sources"
      ],
      "properties": {
        "release_source_commit": { "$ref": "#/$defs/commit" },
        "generator_commit": { "$ref": "#/$defs/commit" },
        "schema_sha256": { "$ref": "#/$defs/sha256" },
        "template_sha256": { "$ref": "#/$defs/sha256" },
        "generator_sha256": { "$ref": "#/$defs/sha256" },
        "sources": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "locked_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "license_key_id",
        "license_public_key_sha256",
        "coordinates",
        "windows_executable"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lockedArtifact" }
        },
        "license_key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "license_public_key_sha256": { "$ref": "#/$defs/sha256" },
        "coordinates": { "$ref": "#/$defs/coordinates" },
        "windows_executable": { "const": "context-engine.exe" }
      }
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "releaseTag": { "type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "target": {
      "type": "string",
      "enum": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu"
      ]
    },
    "artifactUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/context-engine-app/context-engine-mcp/releases/download/v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/[^/]+$"
    },
    "lockedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "url", "sha256", "payload_id", "payload_sha256", "target", "architecture"],
      "properties": {
        "filename": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "url": { "$ref": "#/$defs/artifactUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "payload_id": { "type": "string", "pattern": "^context-engine-[A-Za-z0-9._-]+$" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "target": { "$ref": "#/$defs/target" },
        "architecture": { "type": "string", "enum": ["x86_64", "arm64"] }
      }
    },
    "safePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9._/-]+$" },
    "candidateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "destination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "channel"],
          "properties": {
            "kind": { "const": "homebrew" },
            "repository": { "const": "context-engine-app/homebrew-tap" },
            "channel": { "const": "stable" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "channel"],
          "properties": {
            "kind": { "const": "scoop" },
            "repository": { "const": "context-engine-app/scoop-bucket" },
            "channel": { "const": "stable" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "channel"],
          "properties": {
            "kind": { "const": "winget" },
            "repository": { "const": "microsoft/winget-pkgs" },
            "channel": { "const": "stable" }
          }
        }
      ]
    },
    "coordinates": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["formula_token", "formula_class", "formula_path", "installed_command"],
          "properties": {
            "formula_token": { "const": "context-engine" },
            "formula_class": { "const": "ContextEngine" },
            "formula_path": { "const": "Formula/context-engine.rb" },
            "installed_command": { "const": "context-engine" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["app_name", "manifest_path", "command_alias"],
          "properties": {
            "app_name": { "const": "context-engine" },
            "manifest_path": { "const": "bucket/context-engine.json" },
            "command_alias": { "const": "context-engine" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package_identifier",
            "publisher",
            "manifest_path",
            "default_locale",
            "portable_command_alias"
          ],
          "properties": {
            "package_identifier": { "const": "ContextEngine.ContextEngine" },
            "publisher": { "const": "Context Engine App Ltd" },
            "manifest_path": {
              "type": "string",
              "pattern": "^manifests/c/ContextEngine/ContextEngine/[0-9]+\\.[0-9]+\\.[0-9]+/ContextEngine\\.ContextEngine(?:\\.installer|\\.locale\\.en-US)?\\.yaml$"
            },
            "default_locale": { "const": "en-US" },
            "portable_command_alias": { "const": "context-engine" }
          }
        }
      ]
    }
  }
}
