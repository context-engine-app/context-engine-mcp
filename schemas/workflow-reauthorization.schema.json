{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-engine.app/schemas/workflow-reauthorization.schema.json",
  "title": "Context Engine protected workflow reauthorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tag",
    "stage",
    "execution_ref",
    "original",
    "replacement",
    "reason",
    "approval_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "tag": {
      "type": "string",
      "pattern": "^(?:v|repository-bootstrap-v)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "stage": { "enum": ["public-publish", "package-channels"] },
    "execution_ref": {
      "type": "string",
      "pattern": "^refs/tags/release-reauthorization/(?:v|repository-bootstrap-v)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)/(?:public-publish|package-channels)/[0-9a-f]{40}$"
    },
    "original": { "$ref": "#/$defs/workflow" },
    "replacement": { "$ref": "#/$defs/workflow" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "approval_evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit", "sha256"],
      "properties": {
        "path": {
          "pattern": "^\\.github/workflows/[A-Za-z0-9._/-]+\\.ya?ml$",
          "type": "string"
        },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
