{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-engine.app/schemas/staging-attestation.schema.json",
  "title": "Context Engine Stage A staging attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "release_tag",
    "version",
    "profile",
    "release_asset_set_sha256",
    "release_descriptor_sha256",
    "release_manifest_sha256",
    "package_binding_sha256",
    "build_records",
    "payload_verifications",
    "license_identity",
    "license_smoke",
    "source_commit",
    "distribution_commit",
    "workflow_bindings",
    "run",
    "runner",
    "attempt"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "stage": { "const": "source-release" },
    "release_tag": { "type": "string", "pattern": "^(?:v[0-9]+\\.[0-9]+\\.[0-9]+|repository-bootstrap-v[0-9]+\\.[0-9]+\\.[0-9]+)$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profile": { "type": "string", "enum": ["desktop", "desktop-linux", "repository-bootstrap"] },
    "release_asset_set_sha256": { "$ref": "#/$defs/sha256" },
    "release_descriptor_sha256": { "$ref": "#/$defs/sha256" },
    "release_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "package_binding_sha256": { "$ref": "#/$defs/sha256" },
    "build_records": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/recordRef" } },
    "payload_verifications": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/recordRef" } },
    "license_identity": { "$ref": "#/$defs/licenseIdentity" },
    "license_smoke": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "key_id", "public_key_sha256"],
          "properties": {
            "status": { "const": "passed" },
            "key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
            "public_key_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "not-applicable" } }
        }
      ]
    },
    "source_commit": { "$ref": "#/$defs/commit" },
    "distribution_commit": { "$ref": "#/$defs/commit" },
    "workflow_bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source-release": { "$ref": "#/$defs/workflowBinding" },
        "public-draft": { "$ref": "#/$defs/workflowBinding" },
        "public-publish": { "$ref": "#/$defs/workflowBinding" },
        "package-channels": { "$ref": "#/$defs/workflowBinding" }
      },
      "oneOf": [
        {
          "required": ["source-release", "public-draft"],
          "minProperties": 2,
          "maxProperties": 2
        },
        {
          "required": ["source-release", "public-draft", "package-channels"],
          "minProperties": 3,
          "maxProperties": 3
        },
        {
          "required": ["source-release", "public-draft", "public-publish", "package-channels"],
          "minProperties": 4,
          "maxProperties": 4
        }
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]+$" },
        "url": { "type": "string", "pattern": "^https://github\\.com/context-engine-app/context-engine/actions/runs/[0-9]+$" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "image", "architecture"],
      "properties": {
        "os": { "type": "string", "enum": ["macos", "windows", "linux"] },
        "image": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "enum": ["x86_64", "arm64"] }
      }
    },
    "attempt": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "desktop-linux" }, "version": { "const": "0.1.0" } }, "required": ["profile", "version"] },
      "then": {
        "oneOf": [
          { "properties": { "workflow_bindings": { "required": ["source-release", "public-draft"], "minProperties": 2, "maxProperties": 2 } } },
          { "properties": { "workflow_bindings": { "required": ["source-release", "public-draft", "public-publish", "package-channels"], "minProperties": 4, "maxProperties": 4 } } }
        ]
      },
      "else": {
        "oneOf": [
          { "properties": { "workflow_bindings": { "required": ["source-release", "public-draft"], "minProperties": 2, "maxProperties": 2 } } },
          { "properties": { "workflow_bindings": { "required": ["source-release", "public-draft", "package-channels"], "minProperties": 3, "maxProperties": 3 } } }
        ]
      }
    },
    {
      "if": { "properties": { "profile": { "const": "repository-bootstrap" } } },
      "then": {
        "properties": {
          "license_identity": { "const": { "mode": "not-applicable" } },
          "license_smoke": { "const": { "status": "not-applicable" } },
          "build_records": { "const": [] },
          "payload_verifications": { "const": [] }
        }
      }
    },
    {
      "if": { "properties": { "profile": { "enum": ["desktop", "desktop-linux"] } } },
      "then": {
        "properties": {
          "license_identity": { "required": ["key_id", "public_key_sha256"] },
          "license_smoke": { "required": ["key_id", "public_key_sha256"] },
          "build_records": { "minItems": 1 },
          "payload_verifications": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "licenseIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key_id", "public_key_sha256"],
          "properties": {
            "key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
            "public_key_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "not-applicable" } }
        }
      ]
    },
    "recordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_id", "sha256"],
      "properties": {
        "payload_id": { "type": "string", "pattern": "^context-engine-[A-Za-z0-9._-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "workflowBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._/-]+\\.ya?ml$" },
        "commit": { "$ref": "#/$defs/commit" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
